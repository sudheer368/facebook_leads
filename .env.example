# A string you make up yourself. You'll enter this exact value in the Meta
# Webhooks setup screen when Meta asks to "verify" your callback URL.
VERIFY_TOKEN=choose_any_random_string_here

# Found in Meta App Dashboard > App Settings > Basic
FACEBOOK_APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# Must exactly match the Valid OAuth Redirect URI you set in the Facebook Login product settings
OAUTH_REDIRECT_URI=https://your-deployed-domain.com/auth/facebook/callback

PORT=3000
